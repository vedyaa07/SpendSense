# GEMINI_API_KEY: Required for Gemini AI API calls.
# Server-side only. Never expose to client bundles.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional Gemini model and timeout overrides
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_TIMEOUT_MS="20000"
GEMINI_MAX_TOTAL_MS="45000"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# Supabase Public Configuration (Vite client-side)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
